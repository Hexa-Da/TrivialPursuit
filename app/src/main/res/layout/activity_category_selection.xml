<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CategorySelectionActivity">

    <TextView
        android:id="@+id/tvTitreCategories"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choisissez une catégorie"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="32dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitreCategories"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnGeographie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Géographie"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnHistoire"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Histoire"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnDivertissement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Divertissement"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnArtLitterature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Art et Littérature"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSciencesNature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sciences et Nature"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSportsLoisirs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sports et Loisirs"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnRetour"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Retour"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout> 